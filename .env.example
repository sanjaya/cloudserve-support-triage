# Copy this file to .env and fill in your own values. .env is git-ignored.

# Language model: OpenRouter (key from openrouter.ai). Model names ending in ":free" cost nothing.
OPENROUTER_API_KEY=your_key_here
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# Only for "reasoning" models: set to low and keep the budget; leave empty otherwise
LLM_REASONING_EFFORT=
LLM_REASONING_BUDGET=1024
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
# Placeholder until set from the development-set sweep (FR-04)
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
# "section" or "fixed"; "section" chosen on 2 Nov - see scripts/compare_chunking.py
RETRIEVAL_STRATEGY=section
# Chosen on 2 Nov from the development-set sweep (see Stage 5 revision log, change 1)
RETRIEVAL_MIN_SCORE=0.35

# Classifier (B-06): the language model decides, the trained classifier checks. Confidence comes
# from models/agreement_calibration.json, written by scripts/evaluate_classifier.py --llm-sample 160.
