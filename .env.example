# Copy this file to .env and fill in your own values. .env is git-ignored.

# Language model: OpenRouter (key from openrouter.ai). Model names ending in ":free" cost nothing.
OPENROUTER_API_KEY=your_key_here
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# Only for "reasoning" models: set to low and keep the budget; leave empty otherwise
LLM_REASONING_EFFORT=
LLM_REASONING_BUDGET=1024
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
# Automatic answers need at least this confidence (FR-04). Chosen 5 Nov with scripts/sweep_threshold.py:
# any value from 0.70 to 0.95 allows only tickets where both classification methods agree
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
# "section" or "fixed"; "section" chosen on 2 Nov - see scripts/compare_chunking.py
RETRIEVAL_STRATEGY=section
# Chosen on 2 Nov from the development-set sweep (see Stage 5 revision log, change 1)
RETRIEVAL_MIN_SCORE=0.35

# Classifier (B-06): the language model decides, the trained classifier checks. Confidence comes
# from models/agreement_calibration.json, written by scripts/evaluate_classifier.py --llm-sample 160.

# Which version of prompt PR-03 writes the answers (B-08). 1.1 chosen 5 Nov with scripts/evaluate_answers.py
ANSWER_PROMPT_VERSION=1.1
# Which version of prompt PR-05 checks that answers are supported (B-09); compare with scripts/evaluate_grounding.py
GROUNDING_PROMPT_VERSION=1.0
# Circuit breaker (B-17): after this many failed model questions in a row, stop calling the provider
# for this many seconds; affected tickets go straight to a person
LLM_CIRCUIT_FAILURES=2
LLM_CIRCUIT_COOLDOWN_S=60
# Kill switch (B-21): 1 stops all automatic answers (every ticket goes to a person). Usually you
# use the file switch instead, which works without a restart: python -m src.kill_switch on --by "Name"
KILL_SWITCH=0
